<mujoco model="g1 scene (Stufe 2: Hindernis-Parkour)">
  <!-- Stufe 2 der Testwelten - komplett neu gestaltet am 07.10.2026
       (ersetzt die urspruengliche Version mit nur 3 einfachen Objekten).
       Inspiriert von real genutzten Lauf-Benchmarks fuer zweibeinige/
       vierbeinige Roboter (DARPA Robotics Challenge Terrain, ANYmal/
       ANYbotics Rough-Terrain-Tests, Boston Dynamics Atlas Parkour,
       Isaac Gym/Isaac Lab Terrain-Curricula): 5 Stationen, die jeweils
       eine andere Faehigkeit der Balance-/Lauf-Policy pruefen, plus
       eine Umgrenzung (Mauer links/rechts), damit der Roboter den
       Parkour nicht seitlich verlassen kann, und eine Ziel-Mauer am
       Ende. Jede Station hat ein Schild mit Beschriftung, was dort
       getestet wird.

       WICHTIG zu Station 5 (Schraege statt "Luecke"): Eine echte Luecke/
       ein Loch im Boden war technisch nicht moeglich, weil der Boden
       hier als unendliche MuJoCo-Plane (type="plane") definiert ist -
       eine Plane kann kein Loch haben. Eine Mauer "zum Ausweichen" macht
       bei diesem Roboter ausserdem keinen Sinn, da die aktuelle Policy
       keine Lenkung/Steuerung zur Seite kann (nur Vorwaertslauf). Daher
       stattdessen eine Seitenneigung (cross-slope/Schraege quer zur
       Laufrichtung) - ein etabliertes Element aus echten Rough-Terrain-
       Benchmarks, das seitliche Balance statt Vorwaerts-Balance prueft.

       Stationen im Ueberblick (in Lauf-Richtung +X):
         1. BORDSTEIN  (x=2)   - kleine Stufe hoch+runter, 8cm hoch
         2. HUERDE      (x=4.5) - niedriger Balken quer zum Weg, 10cm hoch
         3. RAMPE       (x=6.6-7.25) - schraege Rampe hoch auf ein Podest
         4. GELAENDE    (x=9-10.5) - unregelmaessige Bodenwellen/Bumps
         5. SCHRAEGE    (x=12)  - seitlich geneigte Flaeche (Querneigung)
       Danach Ziel-Mauer bei x=14. Seitliche Begrenzungsmauern auf ganzer
       Laenge bei y=+-1.5m. Robotermodell exakt wie in scene.xml per
       <include> eingebunden, nicht dupliziert. -->
  <include file="g1_12dof.xml"/>

  <statistic center="6.0 0.7 1.0" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Material fuer alle Hindernis-Geome (Bordstein, Huerde, Rampe,
         Podest, Bodenwellen, Schraege) - einheitliches, deutlich vom
         Boden abgehobenes Orange/Braun. -->
    <material name="hindernis" rgba="0.8 0.5 0.1 1"/>

    <!-- Material fuer die Begrenzungs- und Ziel-Mauern - neutrales Grau,
         damit sie sich klar von den Hindernissen (orange) unterscheiden. -->
    <material name="mauer" rgba="0.5 0.5 0.5 1"/>

    <!-- Beschriftungs-Schilder je Station, gleiche Technik wie in Stufe 1
         (PNG-Textur mit Text auf Box-Geom). -->
    <texture type="2d" name="tex_1_stufe" file="labels/1_stufe.png"/>
    <texture type="2d" name="tex_2_huerde" file="labels/2_huerde.png"/>
    <texture type="2d" name="tex_3_rampe" file="labels/3_rampe.png"/>
    <texture type="2d" name="tex_4_gelaende" file="labels/4_gelaende.png"/>
    <texture type="2d" name="tex_5_schraege" file="labels/5_schraege.png"/>
    <texture type="2d" name="tex_ziel" file="labels/ziel.png"/>
    <material name="schild_1_stufe" texture="tex_1_stufe"/>
    <material name="schild_2_huerde" texture="tex_2_huerde"/>
    <material name="schild_3_rampe" texture="tex_3_rampe"/>
    <material name="schild_4_gelaende" texture="tex_4_gelaende"/>
    <material name="schild_5_schraege" texture="tex_5_schraege"/>
    <material name="schild_ziel" texture="tex_ziel"/>
  </asset>

  <worldbody>
    <light pos="6 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Begrenzungsmauern links/rechts ueber die gesamte Parkour-Laenge
         (x=-1 bis x=14.5), damit der Roboter den Parkour nicht seitlich
         verlassen kann. KOLLIDIERBAR (kein contype/conaffinity=0). -->
    <geom name="wand_links" type="box" pos="6.75 1.5 0.3" size="7.75 0.05 0.3" material="mauer"/>
    <geom name="wand_rechts" type="box" pos="6.75 -1.5 0.3" size="7.75 0.05 0.3" material="mauer"/>

    <!-- Ziel-Mauer am Ende des Parkours (x=14), damit der Roboter dort
         sichtbar stoppt statt unendlich weiterzulaufen. -->
    <geom name="wand_ziel" type="box" pos="14 0 0.4" size="0.05 1.55 0.4" material="schild_ziel"/>

    <!-- Station 1: BORDSTEIN (x=2) - 8cm hohe Stufe/Kante, die der
         Roboter hoch- und wieder heruntersteigen muss. Testet die
         Faehigkeit, einen einfachen Hoehenunterschied im Untergrund
         auszugleichen (vergleichbar mit Buergersteigkanten in echten
         DARPA-Robotics-Challenge-Parcours). -->
    <geom name="station1_bordstein" type="box" pos="2 0 0.04" size="0.3 1 0.04" material="hindernis"/>
    <geom name="schild_1" type="box" pos="2 1.3 0.3" size="0.3 0.02 0.3" material="schild_1_stufe" contype="0" conaffinity="0"/>

    <!-- Station 2: HUERDE (x=4.5) - niedriger Balken (10cm hoch) quer
         zur Laufrichtung, den der Roboter ueberschreiten muss ohne
         daran haengenzubleiben. Testet Fuss-Hebe-Hoehe/Trittsicherheit
         waehrend des Schwungphasen-Verhaltens der Policy. -->
    <geom name="station2_huerde" type="box" pos="4.5 0 0.05" size="0.03 1 0.05" material="hindernis"/>
    <geom name="schild_2" type="box" pos="4.5 1.3 0.3" size="0.3 0.02 0.3" material="schild_2_huerde" contype="0" conaffinity="0"/>

    <!-- Station 3: RAMPE (x=6.6 bis 7.25) - 12 Grad geneigte Rampe
         hinauf auf ein kurzes, erhoehtes Podest (Hoehe ca. 16.6cm).
         Testet kontinuierliches Balancehalten auf geneigtem Untergrund
         waehrend des Vorwaertslaufens (vergleichbar mit Rampen-Tests bei
         ANYmal/Boston Dynamics Atlas). -->
    <geom name="station3_rampe_auf" type="box" pos="6.6 0 0.083" euler="0 12 0" size="0.4 1 0.03" material="hindernis"/>
    <geom name="station3_podest" type="box" pos="7.25 0 0.136" size="0.25 1 0.03" material="hindernis"/>
    <geom name="schild_3" type="box" pos="6.9 1.3 0.3" size="0.3 0.02 0.3" material="schild_3_rampe" contype="0" conaffinity="0"/>

    <!-- Station 4: GELAENDE (x=9.0 bis 10.5) - 7 unregelmaessig verteilte,
         flache Bodenwellen (2-4cm hoch, zufaellig in Groesse/Position
         versetzt). Testet Robustheit gegenueber unebenem, nicht exakt
         vorhersehbarem Untergrund - entspricht den "rough terrain"-
         Trainings-/Test-Curricula aus Isaac Gym/Isaac Lab. -->
    <geom name="bump1" type="box" pos="9.0 -0.6 0.025" size="0.15 0.15 0.025" material="hindernis"/>
    <geom name="bump2" type="box" pos="9.3 0.3 0.035" size="0.12 0.12 0.035" material="hindernis"/>
    <geom name="bump3" type="box" pos="9.6 -0.2 0.02" size="0.18 0.1 0.02" material="hindernis"/>
    <geom name="bump4" type="box" pos="9.9 0.5 0.04" size="0.1 0.15 0.04" material="hindernis"/>
    <geom name="bump5" type="box" pos="10.1 -0.5 0.03" size="0.14 0.12 0.03" material="hindernis"/>
    <geom name="bump6" type="box" pos="10.3 0.1 0.025" size="0.13 0.13 0.025" material="hindernis"/>
    <geom name="bump7" type="box" pos="10.5 -0.1 0.035" size="0.16 0.14 0.035" material="hindernis"/>
    <geom name="schild_4" type="box" pos="9.2 1.3 0.3" size="0.3 0.02 0.3" material="schild_4_gelaende" contype="0" conaffinity="0"/>

    <!-- Station 5: SCHRAEGE (x=12) - um 8 Grad um die Laufrichtungsachse
         (Roll-Achse) geneigte Flaeche, also eine Querneigung/cross-slope,
         KEINE Rampe in Laufrichtung. Testet seitliches Balancehalten,
         wenn der Boden quer zur Laufrichtung geneigt ist - ersetzt die
         urspruenglich angedachte "Luecke" (siehe Kommentar oben, warum
         eine echte Luecke in der Plane technisch nicht moeglich war). -->
    <geom name="station5_schraege" type="box" pos="12 0 0.139" euler="8 0 0" size="0.6 1 0.03" material="hindernis"/>
    <geom name="schild_5" type="box" pos="11.6 1.3 0.3" size="0.3 0.02 0.3" material="schild_5_schraege" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
