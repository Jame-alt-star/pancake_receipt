<mujoco model="g1 scene (Stufe 3: bewegliche Objekte)">
  <!-- Stufe 3 der Testwelten (angelegt 07.10.2026, am selben Tag um
       Beschriftung und Begrenzung erweitert, siehe Chat-Verlauf): frei
       bewegliche Objekte (eigener <freejoint/>, KEINE Verbindung zum
       Roboter) entlang der Laufrichtung (+X), die der Roboter anstossen/
       umlaufen kann - eine leichte Kiste und ein Ball. Testet, wie robust
       die Balance gegen echte, physikalisch simulierte externe Stoerungen
       ist (im Gegensatz zu den frueher beim alten R1/Gazebo-Regler
       kuenstlich eingespeisten Stoerbewegungen). density=200 bewusst
       niedriger als MuJoCos Standard (1000 kg/m3), damit die Objekte vom
       Roboter ueberhaupt wegschiebbar sind statt wie eine Wand zu wirken
       (Kiste ~1.6kg, Ball ~0.84kg bei den gewaehlten Groessen). Sinnvoll
       ERST sobald das reine Laufen auf flachem Boden (Stufe 1,
       scene_lauf.xml) stabil funktioniert, nicht vorher. Robotermodell per
       <include> wie in scene.xml, nicht dupliziert.

       NEU (07.10.2026): wie bei Stufe 2 jetzt mit Beschriftungs-Schildern
       je Station ("KISTE SCHIEBEN"/"BALL SCHIEBEN") sowie seitlichen
       Begrenzungsmauern und einer Ziel-Mauer am Ende, damit der Roboter
       den Parkour nicht verlassen kann bzw. nicht unendlich weiterlaeuft. -->
  <include file="g1_12dof.xml"/>

  <statistic center="3.0 0.7 1.0" extent="2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Material fuer die Begrenzungs- und Ziel-Mauern - gleiche Farbe/
         Technik wie in Stufe 2 (scene_hindernisse.xml). -->
    <material name="mauer" rgba="0.5 0.5 0.5 1"/>

    <!-- Beschriftungs-Schilder je Station, gleiche Technik wie in Stufe 1
         und 2 (PNG-Textur mit Text auf Box-Geom). -->
    <texture type="2d" name="tex_kiste" file="labels/kiste.png"/>
    <texture type="2d" name="tex_ball" file="labels/ball.png"/>
    <texture type="2d" name="tex_ziel" file="labels/ziel.png"/>
    <material name="schild_kiste" texture="tex_kiste"/>
    <material name="schild_ball" texture="tex_ball"/>
    <material name="schild_ziel" texture="tex_ziel"/>
  </asset>

  <worldbody>
    <light pos="3 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Begrenzungsmauern links/rechts entlang der gesamten Parkour-Laenge
         (x=-1 bis x=6.5), damit der Roboter die Objekte nicht einfach
         seitlich umlaufen kann, sondern sie tatsaechlich anstossen/
         wegschieben muss. KOLLIDIERBAR (kein contype/conaffinity=0). -->
    <geom name="wand_links" type="box" pos="2.75 1.5 0.3" size="3.75 0.05 0.3" material="mauer"/>
    <geom name="wand_rechts" type="box" pos="2.75 -1.5 0.3" size="3.75 0.05 0.3" material="mauer"/>

    <!-- Ziel-Mauer am Ende des Parkours (x=6), damit der Roboter dort
         sichtbar stoppt statt unendlich weiterzulaufen. -->
    <geom name="wand_ziel" type="box" pos="6 0 0.4" size="0.05 1.55 0.4" material="schild_ziel"/>

    <!-- Station 1: KISTE SCHIEBEN (x=2) - leichte Kiste (0.2m Kantenlaenge,
         ~1.6kg bei density=200), die sich vom laufenden Roboter anstossen/
         wegschieben lassen sollte. Testet Rutschen/Kippen bei Kontakt mit
         einem kantigen Objekt. Schild steht VOR dem Objekt (x=1.6), damit
         es rechtzeitig sichtbar ist, bevor der Roboter ankommt. -->
    <geom name="schild_kiste_sign" type="box" pos="1.6 1.3 0.3" size="0.3 0.02 0.3" material="schild_kiste" contype="0" conaffinity="0"/>
    <body name="bewegliche_kiste" pos="2 0 0.1">
      <freejoint/>
      <geom name="kiste_geom" type="box" size="0.1 0.1 0.1" density="200" rgba="0.9 0.2 0.2 1"/>
    </body>

    <!-- Station 2: BALL SCHIEBEN (x=4.5) - Ball (Radius 0.1m, ~0.84kg bei
         density=200) - rollt bei Beruehrung weg statt zu rutschen/kippen -
         andere Dynamik als die Kiste, testet eine andere Art von Stoerung.
         Schild steht VOR dem Objekt (x=4.1). -->
    <geom name="schild_ball_sign" type="box" pos="4.1 1.3 0.3" size="0.3 0.02 0.3" material="schild_ball" contype="0" conaffinity="0"/>
    <body name="beweglicher_ball" pos="4.5 0 0.1">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.1" density="200" rgba="0.2 0.5 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
