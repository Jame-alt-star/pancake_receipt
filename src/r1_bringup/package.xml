<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r1_bringup</name>
  <version>0.0.1</version>
  <description>
    Layer 4 (HAL): MuJoCo-Simulation des Unitree G1 (29 DOF) mit Sensorik (IMU, Gelenke, 3D-Lidar,
    Odometrie), Hardware-Bridge-Interface und Policy-/Modell-Dateien. Die alten R1/Gazebo-Launches
    sind Altbestand (siehe Kommentar unten).
  </description>
  <maintainer email="pascalfranz02@gmail.com">Pascal</maintainer>
  <license>Apache-2.0</license>

  <!-- Echte Laufzeit-Abhaengigkeiten des aktuellen MuJoCo-Pfads
       (mujoco_node.py, bridges/mujoco_bridge.py, bridges/i_hardware_bridge.py) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>  <!-- NEU (12.10.2026): fuer /base_position (geometry_msgs/Point), siehe mujoco_node.py -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>  <!-- /odom (Nav2, Layer 2) -->
  <exec_depend>tf2_ros</exec_depend>    <!-- TF odom -> base_link -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- HINWEIS: "mujoco" (das Python-Paket der MuJoCo-Physik-Engine) fehlt
       hier bewusst - das ist kein ROS2-Paket mit eigenem rosdep-Key,
       sondern wird separat per "pip install mujoco" installiert (siehe
       auch mujoco_test/test_g1_mujoco.py im alten Workspace). Gehoert
       deshalb nicht in diese Liste, muss aber weiterhin manuell
       installiert sein, damit mujoco_node.py importierbar ist. -->

  <!-- Generische Launch-Infrastruktur - wird noch von den alten
       RViz/Gazebo-Launch-Dateien benutzt (siehe launch/), auch wenn
       diese fuer den aktuellen MuJoCo-Workflow nicht mehr relevant sind. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Alte R1/Gazebo-Phase (launch/*gazebo*, anzeigen_rviz, bridges/gazebo_bridge.py): deren
       Abhaengigkeiten (robot_state_publisher, joint_state_publisher_gui, ros_gz_sim, ros_gz_bridge,
       controller_manager, joint_state_broadcaster, joint_trajectory_controller, gz_ros2_control)
       sind seit 14.10.2026 KEINE Pflicht mehr (Review Kat. 6: rosdep zog viele unnoetige Pakete).
       Wer die alten Gazebo-Launches nutzt, installiert sie bei Bedarf manuell. -->
  <exec_depend>nav_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
