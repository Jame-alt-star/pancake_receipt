<mujoco model="g1 scene (Stufe 1: einfache Lauf-Welt)">
  <!-- Stufe 1 der Testwelten (angelegt 07.10.2026, erweitert um Zahlen-
       Schilder am selben Tag, siehe Chat-Verlauf): einfache, laengere
       Lauf-Flaeche mit Abstandsmarkierungen alle 1m entlang der X-Achse
       (Annahme: cmd_init=[0.5,0,0] laesst den Roboter in +X-Richtung
       laufen). Jede Markierung besteht aus zwei Teilen: einem orangen
       Streifen auf dem Boden (deutlich anderer Farbton als der blau-graue
       Schachbrett-Boden) UND einem stehenden Schild daneben mit der
       jeweiligen Meterzahl als Textur (1-10), damit man beim Beobachten
       auf einen Blick sieht, wie weit der Roboter gekommen ist, ohne
       nachzaehlen zu muessen. Bewusst KEINE Hindernisse, KEINE beweglichen
       Objekte - die einfachste Welt, um das offene ROS2-
       Synchronisationsproblem (Umfallen) ohne zusaetzliche Stoerfaktoren
       zu debuggen (siehe Stufe 2/3 fuer komplexere Welten, sinnvoll erst
       sobald das reine Laufen stabil ist). Robotermodell exakt wie in der
       normalen scene.xml per <include> eingebunden, nicht dupliziert. -->
  <include file="g1_12dof.xml"/>

  <statistic center="1.0 0.7 1.0" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Zahlen-Texturen fuer die Schilder (1-10), als PNG-Dateien unter
         labels/ abgelegt - orange Hintergrund (gleicher Farbton wie die
         Bodenstreifen), weisse Ziffer, 256x256px. texrepeat bewusst nicht
         gesetzt (Default 1x1), damit die ganze Ziffer auf jede Seite des
         Schild-Quaders abgebildet wird statt gekachelt zu werden. -->
    <texture type="2d" name="zahl_1" file="labels/1.png"/>
    <texture type="2d" name="zahl_2" file="labels/2.png"/>
    <texture type="2d" name="zahl_3" file="labels/3.png"/>
    <texture type="2d" name="zahl_4" file="labels/4.png"/>
    <texture type="2d" name="zahl_5" file="labels/5.png"/>
    <texture type="2d" name="zahl_6" file="labels/6.png"/>
    <texture type="2d" name="zahl_7" file="labels/7.png"/>
    <texture type="2d" name="zahl_8" file="labels/8.png"/>
    <texture type="2d" name="zahl_9" file="labels/9.png"/>
    <texture type="2d" name="zahl_10" file="labels/10.png"/>
    <material name="schild_1" texture="zahl_1"/>
    <material name="schild_2" texture="zahl_2"/>
    <material name="schild_3" texture="zahl_3"/>
    <material name="schild_4" texture="zahl_4"/>
    <material name="schild_5" texture="zahl_5"/>
    <material name="schild_6" texture="zahl_6"/>
    <material name="schild_7" texture="zahl_7"/>
    <material name="schild_8" texture="zahl_8"/>
    <material name="schild_9" texture="zahl_9"/>
    <material name="schild_10" texture="zahl_10"/>

    <!-- NEU (07.10.2026): Ziel-Mauer am Ende der Laufbahn, damit der
         Roboter nicht unendlich weit laeuft, sondern sichtbar an einer
         Wand stoppt/anstoesst. Gleiche Technik wie bei den Zahlen-
         Schildern: Textur auf einen Box-Geom gelegt. -->
    <texture type="2d" name="tex_ziel" file="labels/ziel.png"/>
    <material name="mauer" rgba="0.5 0.5 0.5 1"/>
    <material name="schild_ziel" texture="tex_ziel"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Bodenstreifen alle 1m, alle in derselben, vom Boden deutlich
         abweichenden Farbe (kraeftiges Orange). contype/conaffinity=0,
         rein visuell, keine Kollision mit den Fuessen moeglich. -->
    <geom name="marker_1m" type="box" pos="1 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_2m" type="box" pos="2 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_3m" type="box" pos="3 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_4m" type="box" pos="4 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_5m" type="box" pos="5 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_6m" type="box" pos="6 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_7m" type="box" pos="7 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_8m" type="box" pos="8 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_9m" type="box" pos="9 0 0.001" size="0.02 1 0.001" rgba="1 0.55 0 1" contype="0" conaffinity="0"/>
    <geom name="marker_10m" type="box" pos="10 0 0.001" size="0.02 1 0.001" rgba="0.2 1 0.2 1" contype="0" conaffinity="0"/>

    <!-- Stehende Zahlen-Schilder neben jedem Streifen (y=1.3, also knapp
         ausserhalb der Lauf-Spur y=[-1,1]) - 0.6m breit/hoch, 0.04m dick.
         contype/conaffinity=0, rein visuell, kein Hindernis fuer den
         Roboter. Die Textur wird auf alle Seiten des Quaders gelegt, die
         Zahl ist also von mehreren Blickwinkeln aus lesbar. -->
    <geom name="schild_1m" type="box" pos="1 1.3 0.3" size="0.3 0.02 0.3" material="schild_1" contype="0" conaffinity="0"/>
    <geom name="schild_2m" type="box" pos="2 1.3 0.3" size="0.3 0.02 0.3" material="schild_2" contype="0" conaffinity="0"/>
    <geom name="schild_3m" type="box" pos="3 1.3 0.3" size="0.3 0.02 0.3" material="schild_3" contype="0" conaffinity="0"/>
    <geom name="schild_4m" type="box" pos="4 1.3 0.3" size="0.3 0.02 0.3" material="schild_4" contype="0" conaffinity="0"/>
    <geom name="schild_5m" type="box" pos="5 1.3 0.3" size="0.3 0.02 0.3" material="schild_5" contype="0" conaffinity="0"/>
    <geom name="schild_6m" type="box" pos="6 1.3 0.3" size="0.3 0.02 0.3" material="schild_6" contype="0" conaffinity="0"/>
    <geom name="schild_7m" type="box" pos="7 1.3 0.3" size="0.3 0.02 0.3" material="schild_7" contype="0" conaffinity="0"/>
    <geom name="schild_8m" type="box" pos="8 1.3 0.3" size="0.3 0.02 0.3" material="schild_8" contype="0" conaffinity="0"/>
    <geom name="schild_9m" type="box" pos="9 1.3 0.3" size="0.3 0.02 0.3" material="schild_9" contype="0" conaffinity="0"/>
    <geom name="schild_10m" type="box" pos="10 1.3 0.3" size="0.3 0.02 0.3" material="schild_10" contype="0" conaffinity="0"/>

    <!-- NEU (07.10.2026): Ziel-Mauer bei x=11m - kollidierbar (kein
         contype/conaffinity=0!), damit der Roboter dort tatsaechlich
         stoppt/anstoesst statt unendlich weiter zu laufen. Breite y=[-1.5,1.5]
         deckt die gesamte Lauf-Spur ab, Hoehe 0.8m (deutlich hoeher als der
         Roboter faellt/stolpert). Textur "ZIEL" direkt auf die Mauer gelegt. -->
    <geom name="wand_ziel" type="box" pos="11 0 0.4" size="0.05 1.5 0.4" material="schild_ziel"/>
  </worldbody>
</mujoco>
