<mujoco model="welt demo_lager">
  <!-- Demo-Szenario "Kontrollrundgang im Lager" (14.10.2026).
       Grundriss (x nach rechts, y nach oben), Meter:
         Halle (Lager):  x -1.5 .. 6.5,  y -3.5 .. 3.5
         Buero:          x  6.5 .. 10.0, y -3.5 .. 3.5      Trennwand bei x = 6.5, Tuer y 0.6 .. 2.2 (1.6 m)
         Regal A: x 1.5..4.5, y -1.7..-1.1     Regal B: x 1.5..4.5, y 1.1..1.7   (Gang dazwischen 2.2 m)
         Kistenstapel (1.5 m hoch, vom Lidar erfassbar): (2.2, 0.6) und (5.0, -0.4)
         Buero-Schrank (1.6 m hoch): (9.4, 2.9)
       Alle Hindernisse in geom group 2 (kollidierend UND fuer das Lidar sichtbar; der Lidar sitzt auf
       ~1.24 m, daher sind Hindernisse hoeher). Dekoration (Markierungen, Laderstation, Kisten auf den
       Regalen) ohne Kollision (contype/conaffinity 0) in group 0. -->
  <!-- Nur die Umgebung: den Roboter (g1_29dof.xml aus roboter_simulation) haengt die Simulation beim Laden
       dazu (roboter_simulation/szene.py). Orte fuer Missionen: orte.yaml in diesem Ordner. -->

  <asset>
    <material name="wand"     rgba="0.86 0.86 0.82 1"/>
    <material name="regal"    rgba="0.25 0.40 0.62 1"/>
    <material name="kiste"    rgba="0.78 0.55 0.28 1"/>
    <material name="schrank"  rgba="0.45 0.45 0.50 1"/>
    <material name="gelb"     rgba="0.95 0.80 0.15 1"/>
    <material name="gruen"    rgba="0.20 0.75 0.35 1"/>
    <material name="blau"     rgba="0.20 0.45 0.90 1"/>
    <material name="magenta"  rgba="0.85 0.25 0.65 1"/>
    <material name="rot"      rgba="0.85 0.15 0.15 1"/>
    <material name="weiss"    rgba="0.95 0.95 0.95 1"/>
  </asset>

  <worldbody>
    <!-- Aussenwaende -->
    <geom name="wand_nord" type="box" pos="4.25  3.5 1.0" size="5.85 0.05 1.0" material="wand" group="2"/>
    <geom name="wand_sued" type="box" pos="4.25 -3.5 1.0" size="5.85 0.05 1.0" material="wand" group="2"/>
    <geom name="wand_west" type="box" pos="-1.5   0 1.0" size="0.05 3.55 1.0" material="wand" group="2"/>
    <geom name="wand_ost"  type="box" pos="10.0   0 1.0" size="0.05 3.55 1.0" material="wand" group="2"/>
    <!-- Trennwand Lager/Buero mit Tuer (y 0.6 .. 2.2) -->
    <geom name="trenn_sued"  type="box" pos="6.5 -1.45 1.0" size="0.05 2.05 1.0" material="wand" group="2"/>
    <geom name="trenn_nord"  type="box" pos="6.5  2.85 1.0" size="0.05 0.65 1.0" material="wand" group="2"/>
    <geom name="tuerrahmen_u" type="box" pos="6.5 0.6 1.0" size="0.07 0.04 1.0" material="gelb" group="0" contype="0" conaffinity="0"/>
    <geom name="tuerrahmen_o" type="box" pos="6.5 2.2 1.0" size="0.07 0.04 1.0" material="gelb" group="0" contype="0" conaffinity="0"/>

    <!-- Regale -->
    <geom name="regal_a" type="box" pos="3.0 -1.4 0.9" size="1.5 0.3 0.9" material="regal" group="2"/>
    <geom name="regal_b" type="box" pos="3.0  1.4 0.9" size="1.5 0.3 0.9" material="regal" group="2"/>
    <geom name="ware_a1" type="box" pos="2.2 -1.4 1.95" size="0.35 0.25 0.12" material="kiste" group="0" contype="0" conaffinity="0"/>
    <geom name="ware_a2" type="box" pos="3.6 -1.4 1.95" size="0.45 0.25 0.12" material="weiss" group="0" contype="0" conaffinity="0"/>
    <geom name="ware_b1" type="box" pos="2.6  1.4 1.95" size="0.40 0.25 0.12" material="weiss" group="0" contype="0" conaffinity="0"/>
    <geom name="ware_b2" type="box" pos="3.9  1.4 1.95" size="0.30 0.25 0.12" material="kiste" group="0" contype="0" conaffinity="0"/>

    <!-- Kistenstapel (Hindernisse im Weg) -->
    <geom name="stapel_1" type="box" pos="2.2  0.6 0.75" size="0.35 0.35 0.75" material="kiste" group="2"/>
    <geom name="stapel_2" type="box" pos="5.0 -0.4 0.75" size="0.35 0.35 0.75" material="kiste" group="2"/>
    <geom name="stapel_1b" type="box" pos="2.2 0.6 1.62" size="0.30 0.30 0.12" material="weiss" group="0" contype="0" conaffinity="0"/>

    <!-- Buero -->
    <geom name="schrank"  type="box" pos="9.4 2.9 0.8" size="0.5 0.3 0.8" material="schrank" group="2"/>
    <geom name="tisch"    type="box" pos="8.6 -2.2 0.38" size="0.7 0.4 0.38" material="schrank" group="0" contype="0" conaffinity="0"/>

    <!-- Markierungen: Start, Pruefpunkte K1..K3, Ladestation (nur Optik) -->
    <geom name="m_start" type="cylinder" pos="0.0  0.0 0.004" size="0.35 0.004" material="weiss"   group="0" contype="0" conaffinity="0"/>
    <geom name="m_k1"    type="cylinder" pos="3.0  0.0 0.004" size="0.35 0.004" material="blau"    group="0" contype="0" conaffinity="0"/>
    <geom name="m_k2"    type="cylinder" pos="5.5 -2.6 0.004" size="0.35 0.004" material="gelb"    group="0" contype="0" conaffinity="0"/>
    <geom name="m_k3"    type="cylinder" pos="8.5  1.5 0.004" size="0.35 0.004" material="magenta" group="0" contype="0" conaffinity="0"/>
    <geom name="m_lader" type="cylinder" pos="0.0 -2.6 0.004" size="0.45 0.004" material="gruen"   group="0" contype="0" conaffinity="0"/>
    <geom name="lader_saeule" type="box" pos="-1.3 -2.6 0.6" size="0.08 0.25 0.6" material="gruen" group="0" contype="0" conaffinity="0"/>
    <geom name="gefahr_1" type="box" pos="4.9 -0.4 0.003" size="0.62 0.62 0.003" material="rot" group="0" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
