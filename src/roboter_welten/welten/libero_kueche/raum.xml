<mujoco model="welt libero_kueche">
  <!-- QUELLE fuer szene.xml (nicht direkt geladen): der Raum der Kuechenwelt, von Hand geschrieben wie demo_lager.
       libero_import.py haengt die LIBERO-Fixtures und -Objekte aus aufbau.yaml an und schreibt szene.xml.
       Nach einer Aenderung hier oder in aufbau.yaml neu erzeugen (siehe README.md dieses Ordners).

       Grundriss (x nach rechts, y nach oben), Meter; Roboter startet bei (0, 0) mit Blick +x:
         Raum:            x -1.5 .. 5.5,  y -3.0 .. 3.0
         Kuechenzeile:    x  0.8 .. 4.2,  y  2.37 .. 3.0, Arbeitsflaeche z = 0.80 (Herd, Schubladenschrank, Mikrowelle)
         Haengeschraenke: x  0.8 .. 4.2,  y  2.64 .. 3.0, z 1.30 .. 2.00 (fuer das Lidar auf ~1.24 m knapp darunter)
         Kuehlschrank:    x  4.4 .. 5.1,  y  2.30 .. 3.0, 1.9 m hoch (nur Korpus, keine Tuer)
         Esstisch:        x  1.6 .. 2.8,  y -2.0 .. -1.2, Tischflaeche z = 0.75 (Teller, Schuessel, Becher, Ketchup, Butter)
       Wie in den anderen Welten: Hindernisse in geom group 2 (kollidierend UND fuer das Lidar sichtbar), Dekoration
       ohne Kollision (contype/conaffinity 0). Das 2D-Lidar (~1.24 m) sieht nur Waende und Kuehlschrank; Arbeitsplatte
       und Tisch liegen darunter, die Haengeschraenke darueber (beides sieht das 3D-Lidar). Die Karte
       (karte_aus_szene.py, Hoehenband 0.12-1.9 m) enthaelt sie alle.
       Die LIBERO-Teile (Kollision in group 0) sind fuer Lidar und Karte unsichtbar; sie stehen auf Platte und Tisch. -->

  <asset>
    <material name="wand"    rgba="0.90 0.89 0.85 1"/>
    <material name="korpus"  rgba="0.93 0.93 0.92 1"/>
    <material name="platte"  rgba="0.35 0.33 0.31 1"/>
    <material name="holz"    rgba="0.62 0.45 0.30 1"/>
    <material name="metall"  rgba="0.75 0.77 0.80 1"/>
    <material name="weiss"   rgba="0.95 0.95 0.95 1"/>
    <material name="blau"    rgba="0.20 0.45 0.90 1"/>
    <material name="gelb"    rgba="0.95 0.80 0.15 1"/>
    <material name="gruen"   rgba="0.20 0.75 0.35 1"/>
    <material name="magenta" rgba="0.85 0.25 0.65 1"/>
  </asset>

  <worldbody>
    <!-- Aussenwaende (2 m hoch) -->
    <geom name="wand_nord" type="box" pos="2.0  3.05 1.0" size="3.55 0.05 1.0" material="wand" group="2"/>
    <geom name="wand_sued" type="box" pos="2.0 -3.05 1.0" size="3.55 0.05 1.0" material="wand" group="2"/>
    <geom name="wand_west" type="box" pos="-1.55 0   1.0" size="0.05 3.1 1.0"  material="wand" group="2"/>
    <geom name="wand_ost"  type="box" pos="5.55  0   1.0" size="0.05 3.1 1.0"  material="wand" group="2"/>

    <!-- Kuechenzeile: Unterschrank + Arbeitsplatte (Oberkante z = 0.80) -->
    <geom name="zeile_korpus" type="box" pos="2.5 2.70 0.39" size="1.70 0.30 0.39" material="korpus" group="2"/>
    <geom name="zeile_platte" type="box" pos="2.5 2.69 0.79" size="1.70 0.32 0.01" material="platte" group="2"/>
    <!-- Haengeschraenke -->
    <geom name="haengeschrank" type="box" pos="2.5 2.82 1.65" size="1.70 0.18 0.35" material="korpus" group="2"/>
    <!-- Kuehlschrank (Korpus) mit Griff als Dekoration -->
    <geom name="kuehlschrank" type="box" pos="4.75 2.65 0.95" size="0.35 0.35 0.95" material="metall" group="2"/>
    <geom name="kuehlschrank_griff" type="box" pos="4.50 2.28 1.10" size="0.015 0.02 0.25" material="platte"
          group="0" contype="0" conaffinity="0"/>

    <!-- Esstisch (Tischflaeche z = 0.75) -->
    <geom name="tisch_platte" type="box" pos="2.2 -1.6 0.73" size="0.60 0.40 0.02" material="holz" group="2"/>
    <geom name="tisch_bein_1" type="box" pos="1.65 -1.25 0.355" size="0.03 0.03 0.355" material="holz" group="2"/>
    <geom name="tisch_bein_2" type="box" pos="2.75 -1.25 0.355" size="0.03 0.03 0.355" material="holz" group="2"/>
    <geom name="tisch_bein_3" type="box" pos="1.65 -1.95 0.355" size="0.03 0.03 0.355" material="holz" group="2"/>
    <geom name="tisch_bein_4" type="box" pos="2.75 -1.95 0.355" size="0.03 0.03 0.355" material="holz" group="2"/>

    <!-- Markierungen der Orte aus orte.yaml (nur Optik) -->
    <geom name="m_start"      type="cylinder" pos="0.0  0.0  0.004" size="0.35 0.004" material="weiss"   group="0" contype="0" conaffinity="0"/>
    <geom name="m_herd"       type="cylinder" pos="1.3  1.75 0.004" size="0.30 0.004" material="gelb"    group="0" contype="0" conaffinity="0"/>
    <geom name="m_schrank"    type="cylinder" pos="2.5  1.75 0.004" size="0.30 0.004" material="blau"    group="0" contype="0" conaffinity="0"/>
    <geom name="m_mikrowelle" type="cylinder" pos="3.7  1.75 0.004" size="0.30 0.004" material="magenta" group="0" contype="0" conaffinity="0"/>
    <geom name="m_tisch"      type="cylinder" pos="2.2 -0.55 0.004" size="0.30 0.004" material="gruen"   group="0" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
