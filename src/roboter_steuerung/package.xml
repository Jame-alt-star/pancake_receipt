<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboter_steuerung</name>
  <version>0.0.0</version>
  <description>Layer 3 (Reactive): Zustandsautomat, RL-Lauf-Controller (29-DOF ONNX), Kurs-/Positionshaltung, NotAus/Freigabe, Balance-Dienste, Beinodometrie.</description>
  <maintainer email="pascalfranz02@gmail.com">Pascal Franz</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>r1_bringup</depend>
  <depend>roboter_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- HINWEIS: "onnxruntime" (Python-Paket, von
       control/rl_locomotion_controller_29dof.py fuer die ONNX-Policy
       importiert) hat KEINEN rosdep-Schluessel (geprueft: "rosdep resolve
       python3-onnxruntime" -> no rule) und kann deshalb nicht als
       <depend>/<exec_depend> deklariert werden, ohne "rosdep install" zu
       brechen. Muss separat installiert sein, ebenso "mujoco" (Beinodometrie nutzt das MuJoCo-
       Modell fuer die Vorwaertskinematik) und - nur fuer den alten 12-DOF-Pfad - "torch".
       Versionen: requirements.txt im Projekt-Root:
           pip install onnxruntime (mit Option break-system-packages unter Ubuntu 24.04) -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
