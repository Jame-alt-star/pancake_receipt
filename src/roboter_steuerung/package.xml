<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboter_steuerung</name>
  <version>0.2.0</version>
  <description>Layer 3 (Reactive): Zustandsautomat, RL-Lauf-Controller (29-DOF ONNX), Kurs-/Positionshaltung, NotAus/Freigabe, Balance-Dienste, Beinodometrie.</description>
  <maintainer email="pascalfranz02@gmail.com">Pascal Franz</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>roboter_beschreibung</exec_depend>   <!-- Modell, Geometrie, Quaternion-Hilfen -->
  <exec_depend>roboter_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>   <!-- /steuerung/quittieren -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- HINWEIS: "onnxruntime" (Python-Paket, von
       control/rl_locomotion_controller_29dof.py fuer die ONNX-Policy
       importiert) hat KEINEN rosdep-Schluessel (geprueft: "rosdep resolve
       python3-onnxruntime" -> no rule) und kann deshalb nicht als
       <depend>/<exec_depend> deklariert werden, ohne "rosdep install" zu
       brechen. Muss separat installiert sein, ebenso "mujoco" (Beinodometrie nutzt das MuJoCo-
       Modell fuer die Vorwaertskinematik).
       Versionen: requirements.txt im Projekt-Root:
           pip install onnxruntime (mit Option break-system-packages unter Ubuntu 24.04) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
