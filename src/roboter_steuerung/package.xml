  <!-- HINWEIS: "onnxruntime" (Python-Paket, von
       control/rl_locomotion_controller_29dof.py fuer die ONNX-Policy
       importiert) hat KEINEN rosdep-Schluessel (geprueft: "rosdep resolve
       python3-onnxruntime" -> no rule) und kann deshalb nicht als
       <depend>/<exec_depend> deklariert werden, ohne "rosdep install" zu
       brechen. Muss separat installiert sein, genau wie "mujoco"/"torch"
       (siehe r1_bringup/package.xml):
           pip install onnxruntime (mit Option break-system-packages unter Ubuntu 24.04) -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
