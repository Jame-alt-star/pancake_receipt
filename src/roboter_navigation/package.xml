<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboter_navigation</name>
  <version>0.2.0</version>
  <description>Layer 2 (Navigation): generische Nav2-Konfiguration fuer den G1 in der Simulation.
  Platzhalter, bis die Variante des Kollegen eingebunden wird (siehe README.md).</description>
  <maintainer email="pascalfranz02@gmail.com">Pascal Franz</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>   <!-- nur fuer slam:=true -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>         <!-- nur karte:=... -->
  <exec_depend>nav2_amcl</exec_depend>               <!-- nur karte:=... -->
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Eingaenge /scan und /punkte_hindernis liefert roboter_sensorik (unabhaengig von dieser Nav2-Variante). -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
